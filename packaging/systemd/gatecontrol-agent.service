[Unit]
Description=GateControl agent (remote access: WireGuard, SSH and desktop shares)
Documentation=https://github.com/CallMeTechie/gatecontrol-linux-agent
Wants=network-online.target
After=network-online.target nftables.service
ConditionPathExists=/var/lib/gatecontrol-agent/token

[Service]
Type=simple
ExecStart=/usr/bin/gatecontrol-agent run
Restart=on-failure
RestartSec=5s
User=gatecontrol
Group=gatecontrol
# WireGuard (netlink) and nftables need CAP_NET_ADMIN — nothing else.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
StateDirectory=gatecontrol-agent
StateDirectoryMode=0750
RuntimeDirectory=gatecontrol-agent
RuntimeDirectoryMode=0750
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @raw-io @clock @debug @cpu-emulation @obsolete
Environment=GATECONTROL_AGENT_LOG=info

[Install]
WantedBy=multi-user.target
